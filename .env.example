# ==============================================================
# Quarry - Configuration & API Keys Template
# Rename this file to .env before starting the server.
# ==============================================================

# Server Port (Default: 5000)
PORT=5000

# Client URL for CORS (Default: http://localhost:3000)
CLIENT_URL=http://localhost:3000

# SQLite Database Path (Optional: defaults to server/db/hunting.db)
DATABASE_PATH=./server/db/hunting.db

# Optional AI Provider Keys for Auto-Pilot Pitch Generation
# Supported providers: Anthropic, OpenAI, OpenRouter, Google Gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional Email Dispatch (SMTP or Mailgun/Resend)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password
FROM_EMAIL="Rehan <hello@yourdomain.com>"

# ==============================================================
# Optional External OSINT Toolkit Configuration
# Quarry runs core web dorks, prototype generation, and SQLite natively.
# These optional tools enhance deep reconnaissance if installed:
# ==============================================================
# RapidAPI Key for WhatsLookup (WhatsApp presence & devices)
# RAPIDAPI_KEY=your_rapidapi_key_here
# WHATSLOOKUP_PATH=/path/to/whatslookup

# Blackbird (574+ social networks handle scanner)
# BLACKBIRD_PATH=/path/to/blackbird

# theHarvester (passive certificate logs & subdomains)
# HARVESTER_PATH=/path/to/theHarvester
# UV_PATH=uv

# PhoneInfoga & Sherlock CLIs (defaults to PATH or ~/.local/bin)
# PHONEINFOGA_PATH=phoneinfoga
# SHERLOCK_PATH=sherlock

# Email Deliverability & Verification (check-if-email-exists Rust Engine)
# Bundled by default at server/tools/email-verifier/check_if_email_exists
# EMAIL_VERIFIER_PATH=./server/tools/email-verifier/check_if_email_exists
# Optional SOCKS5 proxy if outbound TCP port 25 is restricted by your local ISP:
# REACHER_PROXY_HOST=127.0.0.1
# REACHER_PROXY_PORT=1080
# REACHER_PROXY_USER=
# REACHER_PROXY_PASS=
